# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:6477,http://127.0.0.1:6477
MAX_UPLOAD_BYTES=104857600
APP_HOST=127.0.0.1
APP_PORT=14499
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=6477
FRONTEND_URL=http://localhost:6477
APP_DATA_DIR=data
APP_SKILLS_DIR=
# Optional. When empty, a persistent key is generated under APP_DATA_DIR/.app_secret.
APP_SECRET_KEY=
MAX_SKILL_UPLOAD_BYTES=20971520
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
DOWNLOAD_URL_TTL_SECONDS=3600

# Optional PPT Master asset pack. Point to the external skills/ppt-master directory.
PPT_MASTER_HOME=

# Backend service credentials. Replace placeholders with actual credentials in your local .env file.
LLM_BASE_URL=http://your-llm-service-host:port/v1
LLM_API_KEY=your-llm-api-key-here
FILE_PARSE_URL=http://your-file-parse-service-host:port/file_parse
FILE_PARSE_TOKEN=your-file-parse-token-here
FILE_PARSE_BACKEND=pipeline
FILE_PARSE_TIMEOUT_SECONDS=600
BOCHA_API_KEY=your-bocha-api-key-here
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search

# Frontend public API base URL (leave empty when using a same-origin proxy).
NEXT_PUBLIC_API_BASE_URL=http://localhost:14499
# Production web/API identity is supplied by a trusted authentication gateway.
APP_ENV=development
# 内网单用户且没有认证网关时，生产环境可显式设为 disabled。
AUTH_MODE=development
# TRUSTED_PROXY_AUTH_SECRET=set-in-server-secret-store
# SANDBOX_PROVIDER=opensandbox
# OPENSANDBOX_DOMAIN=127.0.0.1:8080
# OPENSANDBOX_PROTOCOL=http
# OPENSANDBOX_API_KEY=optional-when-server-auth-is-disabled
# OPENSANDBOX_IMAGE=ai-ppt-sandbox:2026.09
# SANDBOX_REQUEST_TIMEOUT_SECONDS=180
# SANDBOX_COMMAND_TIMEOUT_SECONDS=600
# SANDBOX_READY_TIMEOUT_SECONDS=120
# LANGSMITH_API_KEY=set-in-server-secret-store
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# SANDBOX_IDLE_TTL_SECONDS=3600
# SANDBOX_MAX_ARTIFACT_BYTES=104857600
# SANDBOX_UPLOAD_BATCH_FILES=100
# SANDBOX_UPLOAD_BATCH_BYTES=20971520
# LIBREOFFICE_CONVERT_TIMEOUT_SECONDS=120
# LIBREOFFICE_UNOSERVER_HOST=10.126.13.149
# LIBREOFFICE_UNOSERVER_PORT=8849
# LIBREOFFICE_UNOSERVER_PROTOCOL=http
# LIBREOFFICE_CONVERT_URL=http://converter.example/forms/libreoffice/convert
AGENT_MODEL_CALL_LIMIT=100
AGENT_TOOL_CALL_LIMIT=200
